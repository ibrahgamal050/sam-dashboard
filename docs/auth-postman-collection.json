  },
  "item": [
    {
      "name": "Get CSRF Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/csrf",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "csrf"]
        }
      }
    },
