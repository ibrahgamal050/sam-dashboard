{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./.tests-dist",
    "module": "es2020",
    "moduleResolution": "node",
    "target": "ES2020",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "allowJs": false
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "src/app/api/delivery-zones/**/*.ts"
  ]
}
